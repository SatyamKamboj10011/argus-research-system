# ── Required ────────────────────────────────────────────────────────────────
# Web search. Free tier: https://tavily.com
TAVILY_API_KEY=tvly-...

# At least one model provider is required.
# Free tier: https://console.groq.com
GROQ_API_KEY=gsk_...

# ── Optional model providers ────────────────────────────────────────────────
# https://aistudio.google.com
GOOGLE_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ── HTTP ────────────────────────────────────────────────────────────────────
# Comma-separated. Set this to your real frontend origin in production;
# leaving it as "*" lets any site call your API using your keys.
ALLOWED_ORIGINS=http://localhost:3000

# ── Limits ──────────────────────────────────────────────────────────────────
MAX_TOPIC_LENGTH=300
PIPELINE_TIMEOUT_SECONDS=280
SEARCH_MAX_RESULTS=6
SCRAPE_MAX_PAGES=3
MAX_RESEARCH_CHARS=14000

# How many review chains run at once. Raise only if your provider tier allows it;
# free tiers meter tokens per minute and will reject the burst.
REVIEW_CONCURRENCY=2
LLM_MAX_RETRIES=3

# ── Rate limiting (per client IP) ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=600

# ── Caching ─────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800

# ── Local models ────────────────────────────────────────────────────────────
# Only enable where an Ollama instance is actually reachable.
ALLOW_LOCAL_MODELS=false
OLLAMA_BASE_URL=http://localhost:11434

LOG_LEVEL=INFO
